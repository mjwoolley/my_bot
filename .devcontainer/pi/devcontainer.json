{
    // Raspberry Pi 5 variant. Open with:
    //   F1 -> "Dev Containers: Reopen in Container" -> "MyBot ROS 2 Jazzy + Hailo (Pi 5)"
    //
    // The image is built by the ros2-hailo-dev repo, not pulled from a
    // registry: `./build.sh` there. It is ROS 2 Jazzy on Ubuntu noble plus
    // HailoRT 5.1.1, whose version must match the host's kernel driver.
    //
    // Still built on ros:jazzy-ros-base rather than -desktop, but for a
    // different reason than the Humble image was. Availability is no longer
    // the constraint (ros-jazzy-desktop-full IS published for arm64) -- image
    // size and Pi load are. GUI tools are added one at a time as they earn
    // their place; see the Dockerfile and ../RUNBOOK-jazzy-upgrade.md.
    //
    // HOST: Raspberry Pi OS Trixie (Debian 13).
    //
    // PREFER `mybot` (or run-container.sh directly) over this file. The
    // device list below is static and every entry must exist or Docker
    // refuses to start; run-container.sh GENERATES the list from what is
    // actually present, and additionally passes the X cookie, /dev/dri, the
    // HEF mount and MYBOT_VIDEO_DEVICE. This config is the VS Code path only.
    "name": "MyBot ROS 2 Jazzy + Hailo (Pi 5)",
    "image": "ros2-hailo-dev:0.1.0",
    "remoteUser": "ros",

    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

    "runArgs": [
        // host networking + host IPC so DDS can discover the workstation
        "--network=host",
        "--ipc=host",

        // PID 1 is a long-lived sleep, which does not reap children. Without
        // an init, every node you stop leaves a zombie behind.
        "--init",

        // Containers do not inherit the host's core limit: the host is 0 but
        // the daemon default is unlimited, and core_pattern is the relative
        // "core", so dumps land in the CWD -- which is the bind-mounted repo
        // root. One bring-up session left 407 MB of them there, invisibly,
        // because they are gitignored. The crashes that produced them were
        // SIGABRT on fatal misconfiguration at startup (usb_cam on a bad
        // V4L2 node, Qt with no platform integration), where the stderr
        // message is the whole diagnosis.
        "--ulimit", "core=0",

        // ---- Serial devices ----------------------------------------------
        // Two physical devices, five names. Docker resolves a --device
        // symlink on the host and recreates a real node inside the container
        // under the given name, so each alias becomes its own node pointing
        // at the same major:minor:
        //
        //   /dev/arduino  /dev/motor  /dev/ttyUSB1   -> CH340,   1a86:7523
        //   /dev/rplidar  /dev/ttyUSB0               -> CP2102N, 10c4:ea60
        //
        // The symlinks come from udev rules on the HOST, tracked in this repo
        // at .devcontainer/pi/udev/. Install them before first use:
        //   sudo cp .devcontainer/pi/udev/*.rules /etc/udev/rules.d/
        //   sudo udevadm control --reload-rules && sudo udevadm trigger
        //
        // PREFER the stable names in commands -- ttyUSBn ordering can swap
        // between boots. They are passed only because upstream defaults
        // hardcode /dev/ttyUSB0:
        //   ros2 launch rplidar_ros rplidar_c1_launch.py \
        //     serial_port:=/dev/rplidar frame_id:=laser_frame
        //   ros2 run serial_motor_demo driver --ros-args \
        //     -p serial_port:=/dev/motor -p baud_rate:=57600
        // frame_id is required: the launch file defaults to `laser`, but
        // lidar.xacro publishes the link as `laser_frame`.
        "--device=/dev/arduino",
        "--device=/dev/motor",
        "--device=/dev/rplidar",
        "--device=/dev/ttyUSB0",
        "--device=/dev/ttyUSB1",

        // ---- Camera: Logitech C920 (USB / UVC) ---------------------------
        // A UVC webcam emits finished YUYV/MJPG frames, so it needs exactly
        // one node and none of the CSI machinery the IMX500 required (no
        // dma_heap, no media devices, no v4l-subdevs, no /run/udev mount --
        // that was all for libcamera, which is no longer in the picture).
        //
        // /dev/webcam is a udev symlink to the CAPTURE node. The C920 claims
        // two video nodes and only index 0 captures; index 1 is metadata-only
        // and pointing a camera node at it fails. The bare videoN numbering
        // is not stable across reboots, which is why the symlink exists.
        "--device=/dev/webcam",

        // ---- Hailo-10H NPU ------------------------------------------------
        // The kernel driver (hailo1x_pci, DKMS) stays on the HOST and is
        // apt-managed from archive.raspberrypi.com. Only this character
        // device is passed in; HailoRT userspace inside the container talks
        // to it via ioctl/mmap with no virtualization overhead.
        //
        // HARD REQUIREMENT: the HailoRT userspace in the image must match the
        // host driver version EXACTLY (5.1.1 today). A mismatch fails at
        // runtime, not at build time.
        "--device=/dev/hailo0",

        // `ros` is not in dialout (serial) or video (camera) by default.
        // Assumes the container's GIDs match the host's -- both are 20/44 on
        // Debian and Ubuntu, including Raspberry Pi OS.
        //
        // Camera access would also work via the host ACL (`user:mike:rw-` on
        // every /dev/video*), because `ros` is uid 1000 and so is `mike` --
        // but that ACL is not tracked anywhere, so do not rely on it.
        "--group-add=dialout",
        "--group-add=video"
    ],

    // Deliberately absent vs the workstation config:
    //   --gpus=all          no NVIDIA on the Pi; the Hailo NPU is passed as a
    //                       character device instead, see above.
    //   DISPLAY / X11 mount this path stays headless. The image CAN draw
    //                       (rqt_image_view, rviz2), but the X cookie mount
    //                       and hostname pinning that make it work under
    //                       labwc live in run-container.sh. Use `mybot` when
    //                       you want a window.
    "containerEnv": {},

    "customizations": {
        "vscode": {
            // cpptools is dropped on purpose. The workspace DOES carry
            // C++ now (rplidar_ros and its vendored SDK), so this is no
            // longer "there is nothing to index" -- it is that indexing the
            // ROS headers is the single heaviest thing you can ask a Pi to
            // do in the background. Edit the lidar driver on the workstation.
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "anthropic.claude-code"
            ]
        }
    }
}
