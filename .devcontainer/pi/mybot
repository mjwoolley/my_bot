#!/usr/bin/env bash
# mybot -- open a shell in the ROS 2 container, starting it if necessary.
#
# The original of this script lived only in ~/.local/bin on the old Pi and was
# lost in the Raspberry Pi OS migration (the Phase 0 backup took
# ~/.local/share but not ~/.local/bin). It lives in the repo now.
#
# Install:
#   ln -sf "$PWD/.devcontainer/pi/mybot" ~/.local/bin/mybot
#
# Usage:
#   mybot              open a shell (starts the container if stopped/absent)
#   mybot run CMD...   run one command in the container, then exit
#   mybot status       container state and device/mount summary
#   mybot start        start or create, do not attach
#   mybot stop         stop the container (does not delete it)
#   mybot restart      recreate from run-container.sh, then attach
#   mybot logs         docker logs
set -euo pipefail

NAME=${NAME:-mybot-hailo}

# The starter now lives in the OTHER repo. ros2-hailo-dev owns the Jazzy +
# HailoRT image and the run script that knows about the HEF mount, the X
# cookie and /dev/hailo0; duplicating it here is what let `mybot` silently
# build a Humble container with none of that. Overridable, because the two
# repos are not required to sit side by side.
HERE=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
STARTER=${MYBOT_STARTER:-$HERE/../../../docker/ros2-hailo-dev/run-container.sh}
if [ ! -x "$STARTER" ]; then
    echo "mybot: cannot find run-container.sh at $STARTER" >&2
    echo "       Clone ros2-hailo-dev beside my_bot, or set MYBOT_STARTER." >&2
    exit 1
fi

exists()  { docker inspect "$NAME" >/dev/null 2>&1; }
running() { [ "$(docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" = "true" ]; }

# docker exec flags: -i always, -t only when stdin really is a terminal.
# Hardcoding -it breaks every non-interactive caller (ssh host 'mybot run ...',
# scripts, CI) with "cannot attach stdin to a TTY-enabled container".
tty_flags() { if [ -t 0 ]; then printf -- '-it'; else printf -- '-i'; fi; }

ensure_up() {
    if running; then return 0; fi
    if exists; then
        # `docker start` resumes the SAME writable layer -- anything apt
        # installed is still there. Only a recreate loses it.
        echo "Starting existing container '$NAME'..." >&2
        docker start "$NAME" >/dev/null
    else
        echo "No container '$NAME'. Creating from run-container.sh..." >&2
        [ -x "$STARTER" ] || { echo "mybot: $STARTER missing or not executable" >&2; exit 1; }
        "$STARTER"
    fi
}

case "${1:-shell}" in
    shell)
        ensure_up
        exec docker exec $(tty_flags) "$NAME" bash
        ;;
    run)
        shift
        [ $# -gt 0 ] || { echo "mybot run: need a command" >&2; exit 2; }
        ensure_up
        exec docker exec $(tty_flags) "$NAME" bash -lc "$*"
        ;;
    start)
        ensure_up
        docker ps --filter "name=$NAME" --format '{{.Names}}  {{.Status}}'
        ;;
    stop)
        exists || { echo "No container '$NAME'." >&2; exit 1; }
        docker stop "$NAME" >/dev/null && echo "Stopped $NAME."
        ;;
    restart)
        [ -x "$STARTER" ] || { echo "mybot: $STARTER missing" >&2; exit 1; }
        "$STARTER"
        exec docker exec $(tty_flags) "$NAME" bash
        ;;
    logs)
        shift
        exec docker logs "${@:---tail=50}" "$NAME"
        ;;
    status)
        if ! exists; then echo "container : absent"; exit 0; fi
        printf 'container : %s\n' "$(docker inspect -f '{{.State.Status}}' "$NAME")"
        printf 'image     : %s\n' "$(docker inspect -f '{{.Config.Image}}' "$NAME")"
        printf 'devices   : %s\n' "$(docker inspect -f '{{len .HostConfig.Devices}}' "$NAME")"
        # No udev line. Both container scripts deliberately dropped /run/udev
        # when libcamera and the CSI camera were retired; usb_cam walks the
        # host's /sys directly and does not need it. The old check printed
        # "camera will not enumerate" on a working robot, every time.
        printf 'HEF mount : %s\n' \
            "$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/usr/share/hailo-models"}}yes{{end}}{{end}}' "$NAME" | grep -q yes && echo yes || echo "NO -- no models, detection will fail")"
        printf 'NPU       : %s\n' \
            "$(docker inspect -f '{{range .HostConfig.Devices}}{{if eq .PathInContainer "/dev/hailo0"}}yes{{end}}{{end}}' "$NAME" | grep -q yes && echo yes || echo "NO -- /dev/hailo0 not passed")"
        printf 'init      : %s\n' "$(docker inspect -f '{{.HostConfig.Init}}' "$NAME")"
        if running; then
            echo "--- serial symlinks inside ---"
            docker exec "$NAME" ls -l /dev/arduino /dev/motor /dev/rplidar 2>&1 | sed 's/^/  /'
        fi
        ;;
    -h|--help|help)
        sed -n '2,20p' "$(readlink -f "${BASH_SOURCE[0]}")" | sed 's/^# \{0,1\}//'
        ;;
    *)
        echo "mybot: unknown command '$1' (try: mybot help)" >&2
        exit 2
        ;;
esac
