<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mybot_detection</name>
  <version>0.0.0</version>
  <description>Object detection on the Hailo-10H NPU. Subscribes to camera images, runs YOLO on the accelerator, and publishes vision_msgs/Detection2DArray plus an optional annotated image. Arm64-only by nature: it needs the NPU.</description>
  <maintainer email="mwoolley2@gmail.com">mwoolley2</maintainer>
  <license>Apache-2.0</license>

  <!-- Runtime dependencies with an arm64 build, per the same rule that keeps
       Gazebo out of mybot. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- NOT DECLARED, ON PURPOSE: HailoRT.
       `hailo_platform` (pyhailort) has no rosdep key. It comes from the
       container image (see the ros2-hailo-dev repo), and its version must
       match the host's PCIe kernel driver exactly. `rosdep install` will
       neither supply nor check it; the node fails at import if it is absent. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
