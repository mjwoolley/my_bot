<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mybot_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo simulation and RViz configs for mybot. Workstation only: gazebo_ros and gazebo_ros_pkgs have no arm64 build, so this package is not installable on the Pi.</description>
  <maintainer email="mwoolley2@gmail.com">mwoolley2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The robot description this package simulates -->
  <exec_depend>mybot_description</exec_depend>

  <!-- amd64 only. These are the keys that make `rosdep install` fail on arm64,
       which is the whole reason they live here and not in mybot_description. -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>

  <!-- Visualisation. rviz2 and joint_state_publisher_gui do have arm64 builds,
       but a headless robot has no use for them. -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
