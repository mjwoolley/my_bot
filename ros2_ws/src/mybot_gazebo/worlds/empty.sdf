<?xml version="1.0" ?>
<!--
  Empty world: ground plane, a sun, and the four system plugins Harmonic needs.

  Deliberately has NO network dependency. The Classic version used
  <include><uri>model://sun</uri></include> and the same for ground_plane,
  which resolved through Gazebo Classic's model DATABASE. Harmonic has no such
  database - the equivalent would be a Fuel URI, and "the world you debug
  everything else with needs the internet" is a bad property. Both are inlined.
-->
<sdf version="1.10">
  <world name="default">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- gz-sim loads a default plugin set ONLY if the SDF declares no <plugin>
         at all. Declare one and you own the whole list, and every omission
         fails silently: no Physics is a frozen sim, no UserCommands makes
         `ros_gz_sim create` time out, no SceneBroadcaster is an empty GUI, and
         no Sensors means no /scan and no camera image. Sensors is the direct
         replacement for Classic's libgazebo_ros_*_sensor.so machinery. -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- No <gui> block on purpose. The Classic <gui><camera> pose has no
         Harmonic meaning, and a <gui> element with no <plugin> children can
         make gz-sim load NO gui plugins and hand you a blank window. Omitting
         it falls back to ~/.gz/sim/8/gui.config, which is the sane default. -->

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <!-- Was a Gazebo/Grey material SCRIPT. ogre2 has no Ogre material
               scripts; colours are given directly. -->
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
