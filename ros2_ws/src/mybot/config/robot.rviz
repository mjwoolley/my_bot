# RViz layout for the real robot: model + lidar + the annotated detections.
#
# Lives in mybot, not mybot_gazebo, which is where this repo used to put RViz
# configs. That convention existed only because rviz2 had no arm64 Humble
# build and was therefore a workstation-only tool. On Jazzy it is installed in
# the Pi's own image, and mybot_gazebo now carries a COLCON_IGNORE -- a config
# left there would not be installed on the robot at all.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LaserScan1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Name: root
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 160; 160; 164
      Alpha: 0.5
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3

    # frame_id is laser_frame, matching mybot/description/lidar.xacro. The
    # vendored rplidar launch file defaults to `laser`, which does not exist
    # in this robot's TF tree -- if the scan does not appear, check that
    # first.
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        # Sensor data is published best-effort. A Reliable subscription here
        # is the classic silent-empty-display bug: QoS never matches and
        # RViz shows nothing, with no error.
        Reliability Policy: Best Effort
      Size (m): 0.02
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 85; 0
      Decay Time: 0

    # The detector's own output, boxes already drawn. Subscribing to the
    # annotated stream rather than /image_raw + a MarkerArray keeps this
    # config passive: nothing here has to know the vision_msgs layout.
    - Class: rviz_default_plugins/Image
      Name: Detections
      Enabled: true
      Topic:
        Value: /detections/image_annotated
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 1
      Min Value: 0
      Normalize Range: true

  Global Options:
    # base_link, not odom or map: nothing publishes either yet. There is no
    # odometry source and no SLAM in this workspace.
    Fixed Frame: base_link
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3
      Pitch: 0.5
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: <Fixed Frame>
    Saved: ~
Window Geometry:
  Height: 800
  Width: 1200
  Displays:
    collapsed: false
  Detections:
    collapsed: false
