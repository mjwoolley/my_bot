<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <joint name="camera_joint" type="fixed">
        <parent link="chassis" />
        <child link="camera_link" />
        <origin xyz="0.305 0.0 0.08" rpy="0 0 0" />
    </joint>

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="0.010 0.03 0.03" />
            </geometry>
            <material name="red" />
        </visual>
    </link>

    <joint name="camera_optical_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_link_optical" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>

    <link name="camera_link_optical"></link>
   

    <!-- Simulation only. The links and joints above are the real robot's
         and must always be built: rsp.launch.py needs laser_frame and
         camera_link_optical on hardware. Only this block is gated. -->
    <xacro:if value="$(arg use_sim)">
        <gazebo reference="camera_link">
            <sensor name="camera" type="camera">
                <pose>0 0 0 0 0 0</pose>
                <update_rate>10</update_rate>
                <always_on>true</always_on>
                <visualize>true</visualize>

                <!-- gz derives the info topic by replacing the last element of
                     <topic>, so /camera/image_raw gives /camera/camera_info for
                     free (CameraSensor::AdvertiseInfo).

                     <gz_frame_id> replaces Classic's plugin <frame_name>. Do
                     NOT also set <camera><optical_frame_id>: it defaults to
                     this value, so setting both is only a way to get them out
                     of sync.

                     camera_link_optical, not camera_link: a gz camera looks
                     down its link's +X, ROS optical convention is +Z forward,
                     and camera_optical_joint above is exactly that rotation.
                     An image rotated 90 degrees in RViz means this changed. -->
                <topic>/camera/image_raw</topic>
                <gz_frame_id>camera_link_optical</gz_frame_id>

                <!-- 640x480 matches the real C920's usb_cam config in
                     mybot_detection, so the detector could be pointed at the
                     simulation without re-tuning. -->
                <camera>
                    <horizontal_fov>1.089</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                    </image>
                    <clip>
                        <near>0.05</near>
                        <far>8.0</far>
                    </clip>
                </camera>
            </sensor>
        </gazebo>
    </xacro:if>

</robot>