<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <joint name="laser_joint" type="fixed">
        <parent link="base_link" />
        <child link="laser_frame" />
        <origin xyz="0.1 0.0 0.175" rpy="0 0 0" />
    </joint>
    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04" />
            </geometry>
            <material name="red" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder
            mass="0.1" radius="0.05" length="0.04">
            <origin xyz="0 0 0" rpy="0 0 0" />
        </xacro:inertial_cylinder>
    </link>

    <!-- Simulation only. The links and joints above are the real robot's
         and must always be built: rsp.launch.py needs laser_frame and
         camera_link_optical on hardware. Only this block is gated. -->
    <xacro:if value="$(arg use_sim)">
        <gazebo reference="laser_frame">
            <sensor name="laser" type="gpu_lidar">
                <pose>0 0 0 0 0 0</pose>
                <update_rate>10</update_rate>
                <always_on>true</always_on>
                <visualize>false</visualize>

                <!-- Both of these are load-bearing, and both fail silently.
                     Without <topic>, gz publishes on the scoped path
                     /world/default/model/my_bot/link/base_link/sensor/laser/scan
                     - base_link, not laser_frame, because sdformat lumps
                     fixed-joint children into their parent. Without
                     <gz_frame_id>, header.frame_id is the sensor's mangled
                     post-lump name (laser_frame_fixed_joint_lump__laser), and
                     RViz has no such frame so it draws nothing. -->
                <topic>/scan</topic>
                <gz_frame_id>laser_frame</gz_frame_id>

                <!-- Harmonic renames the container element <ray> -> <lidar>.
                     sdformat still accepts <ray> as a deprecated alias, but it
                     warns, and the deprecated path is not the one to be on. -->
                <lidar>
                    <scan>
                        <horizontal>
                            <samples>500</samples>
                            <!-- A multiplier on samples, not an angular step. -->
                            <resolution>1</resolution>
                            <min_angle>-3.14</min_angle>
                            <max_angle>3.14</max_angle>
                        </horizontal>
                        <!-- Spec-optional, included deliberately: it states the
                             single-ring intent, and an unspecified vertical
                             block has repeatedly been the cause of an empty
                             scan in gz-sensors. -->
                        <vertical>
                            <samples>1</samples>
                            <resolution>1</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.05</min>
                        <max>12.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>
            </sensor>
        </gazebo>
    </xacro:if>

</robot>