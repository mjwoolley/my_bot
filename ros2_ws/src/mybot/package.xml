<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mybot</name>
  <version>0.0.0</version>
  <description>URDF/Xacro description and headless launch files for mybot. Arm64-safe: no Gazebo or GUI dependencies, so this package installs on the Pi.</description>
  <maintainer email="mwoolley2@gmail.com">mwoolley2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies used by the launch files / description.
       Everything here has an arm64 build. Gazebo and RViz deps live in
       mybot_gazebo so that `rosdep install` succeeds on the Pi. -->
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
