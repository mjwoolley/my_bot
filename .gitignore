# --- colcon / ROS 2 workspace build artifacts ---
build/
install/
log/

# Per-machine marker telling colcon to skip a package. The Pi uses one in
# mybot_gazebo (gazebo_ros has no arm64 build); the workstation must still
# build that package, so this stays local to each machine.
COLCON_IGNORE

# --- ROS / Gazebo runtime ---
*.bag
*.db3
*.active
.gazebo/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Editor / OS ---
*.swp
*~
.DS_Store

# --- Crash dumps ---
# The motor driver work produced several 100+ MB core files in ros2_ws/.
core
core.*
