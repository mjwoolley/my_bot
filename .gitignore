# --- colcon / ROS 2 workspace build artifacts ---
build/
install/
log/

# Per-machine marker telling colcon to skip a package. This was local to
# each machine while the Pi was the only box that could not build
# mybot_gazebo. It is now tracked instead: gazebo_ros and gazebo_ros_pkgs
# have no Jazzy release at all (gazebo_ros_pkgs was discontinued after
# Iron), so `rosdep install --from-paths src` fails on EVERY machine until
# the Gazebo Classic -> Harmonic port happens. The marker in mybot_gazebo
# is committed with `git add -f`; this rule still covers any other one.
COLCON_IGNORE

# --- ROS / Gazebo runtime ---
*.bag
*.db3
*.active
.gazebo/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Editor / OS ---
*.swp
*~
.DS_Store

# --- Crash dumps ---
# The motor driver work produced several 100+ MB core files in ros2_ws/.
core
core.*

# HailoRT drops these wherever a process using it runs.
hailort.log
hailort.*.log
