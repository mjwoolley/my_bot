# --- colcon / ROS 2 workspace build artifacts ---
build/
install/
log/

# Per-machine marker telling colcon to skip a package. Untracked on purpose:
# which packages a given box can build is a property of the box, not of the
# repo. mybot_gazebo carried a tracked one while the Gazebo Classic -> Harmonic
# port was outstanding; that is done, so it is gone.
#
# The Pi still cannot resolve mybot_gazebo's deps -- ros_gz_sim and
# ros_gz_bridge are not in the ros2-hailo-dev image, by choice. Drop an
# untracked COLCON_IGNORE there, or build with
#   --skip-keys "ros_gz_sim ros_gz_bridge"
COLCON_IGNORE

# --- ROS / Gazebo runtime ---
*.bag
*.db3
*.active
.gazebo/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Editor / OS ---
*.swp
*~
.DS_Store

# --- Crash dumps ---
# The motor driver work produced several 100+ MB core files in ros2_ws/.
core
core.*

# HailoRT drops these wherever a process using it runs.
hailort.log
hailort.*.log
